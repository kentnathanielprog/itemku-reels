# Copy to .env for local runs (never commit .env). In Claude Code cloud / GitHub Actions use environment variables / secrets instead.
ANTHROPIC_API_KEY=          # produce.py: writer + QC + vision calls
IG_USER_ID=                 # Instagram professional account id (Graph API)
IG_ACCESS_TOKEN=            # long-lived token (refresh before it expires, ~60 days)
GRAPH_HOST=graph.instagram.com      # or graph.facebook.com if you use Facebook Login
GRAPH_VERSION=v21.0                 # verify against Meta's current docs
